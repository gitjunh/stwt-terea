{
  "name": "terea",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-sqlite server/index.mjs",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "db:seed": "node --experimental-sqlite server/seed.mjs --reset",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --experimental-sqlite server/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
